# FraudScope AI Environment Configuration Example

# Backend Settings
PROJECT_NAME="FraudScope AI"
VERSION="1.0.0"
DATABASE_URL="sqlite:///./fraudscope.db"

# Risk Scoring Boundaries (0-100)
RISK_THRESHOLD_LOW=35
RISK_THRESHOLD_HIGH=65
SIMILARITY_THRESHOLD=0.78
DEMO_MODE=false # Set to true to seed synthetic demonstration records on empty database

# Optional External URL Reputation Provider API Keys
# If left blank, local static heuristics will be evaluated with status "check_unavailable"
GOOGLE_SAFE_BROWSING_API_KEY=""
VIRUSTOTAL_API_KEY=""

# Telegram Live Feed Configuration (Telethon MTProto API)
# 1. Visit https://my.telegram.org and log in with your Telegram account.
# 2. Go to "API development tools" and create a new application to get API_ID and API_HASH.
# 3. Enter your credentials below:
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
# Comma-separated list of public channel usernames (e.g. "@fraud_watch,mule_alerts,https://t.me/suspicious_ads")
TELEGRAM_CHANNELS="fraud_alerts_channel,mule_recruitment_watch"
# SQLite session storage name for Telethon (stored locally in backend/)
TELEGRAM_SESSION_NAME="fraudscope_telegram"
# Optional Telegram Bot Token (if running with Bot credentials)
TELEGRAM_BOT_TOKEN=""
# Polling/catch-up interval in seconds for channel updates
TELEGRAM_POLL_INTERVAL=30

# Meta Ad Library Integration (Facebook & Instagram - Graph API v21.0)
# Optional: Requires Meta Developer App with Ads Archive API permission (ads_read)
META_ACCESS_TOKEN=""
META_APP_ID=""
META_APP_SECRET=""

# CORS Allowed Origins (Comma-separated for production deployments)
BACKEND_CORS_ORIGINS="http://localhost:5173,https://fraudscopeai.onrender.com"

# Frontend Settings for Vercel deployment (set in Vercel Project Settings -> Environment Variables)
# Supports either VITE_API_BASE_URL or VITE_API_URL (with or without /api suffix)
VITE_API_BASE_URL="https://fraudscopeai.onrender.com"
VITE_API_URL="https://fraudscopeai.onrender.com"

